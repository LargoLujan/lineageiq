{
  "name": "Fabric Lineage Mapper",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "lineageiq",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Semantic lineage app",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "codexbuild.codex-build",
        "ms-vscode-remote.remote-containers",
        "fabric.vscode-fabric",
        "fabric.vscode-fabric-mcp-server",
        "synapsevscode.synapse",
        "ms-azuretools.vscode-azure-mcp-server",
        "ms-azuretools.azure-dev",
        "ms-azuretools.vscode-docker",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-azuretools.vscode-azurestorage",
        "ms-azure-devops.azure-pipelines",
        "ms-vscode.azure-repos",
        "ms-mssql.mssql",
        "ms-mssql.data-workspace-vscode",
        "ms-mssql.sql-database-projects-vscode",
        "ms-vscode.powershell",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "anytechiestudio.graphify-vscode",
        "hediet.vscode-drawio",
        "mermaidchart.vscode-mermaid-chart",
        "vstirbu.vscode-mermaid-preview",
        "mhutchie.git-graph",
        "eamodio.gitlens",
        "davidanson.vscode-markdownlint",
        "marp-team.marp-vscode"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "files.eol": "\n",
        "markdown.preview.breaks": false
      }
    }
  },
  "postCreateCommand": "az --version >/tmp/az-version.txt && fab --version >/tmp/fab-version.txt && python --version >/tmp/python-version.txt && pwsh --version >/tmp/pwsh-version.txt && node --version >/tmp/node-version.txt && npm --version >/tmp/npm-version.txt && chromium --version >/tmp/chromium-version.txt",
  "postStartCommand": "/workspace/backend/scripts/start_lineage_web.sh >/tmp/lineage-web-poststart.log 2>&1 || true"
}
