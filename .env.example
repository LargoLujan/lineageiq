# Copy this file to `.env` only for local work. Do not commit `.env`.

# Runtime mode
FABRIC_MAPPER_MODE=read_only
LINEAGE_VISUAL_PORT=8765

# Optional Azure DevOps read-only access
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=

# Optional SQL metadata extraction credentials.
# Prefer setting these in the current shell/session instead of storing them.
SQL_METADATA_HOST=
SQL_METADATA_PORT=1433
SQL_METADATA_USER=
SQL_METADATA_PASSWORD=

# Alternative names supported by some scripts.
FABRIC_LINEAGE_SQL_METADATA_HOST=
FABRIC_LINEAGE_SQL_METADATA_PORT=1433
FABRIC_LINEAGE_SQL_METADATA_USER=
FABRIC_LINEAGE_SQL_METADATA_PASSWORD=

# Optional local paths checked (presence only, never read) by
# backend/scripts/00_preflight_tools.ps1
FABRIC_LINEAGE_REFERENCE_PROJECT=
FABRIC_LINEAGE_SECRET_ENV_FILE=

# Optional visual validation overrides
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
PLAYWRIGHT_JSON_OUTPUT_NAME=analysis/visual-validation/playwright-results.json
